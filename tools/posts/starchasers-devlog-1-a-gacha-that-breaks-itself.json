     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "With the look settled, the next question was the big one: how should a fight in Starchasers feel? That's ",
       "decorations": []
      }
     },
     {
      "type": "TEXT",
      "id": "",
