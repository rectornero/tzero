   {
    "type": "PARAGRAPH",
    "nodes": [
     {
      "type": "TEXT",
      "textData": {
       "text": "Games close all the time. What makes this one strange is how little it looked like a game on its way out. UNITE passed ",
       "decorations": []
      }
     },
     {
      "type": "TEXT",
      "textData": {
       "text": "200 million downloads",
       "decorations": [
        {
         "type": "LINK",
         "linkData": {
          "link": {
           "url": "https://unite.pokemon.com/en-us/news/pokemon-unite-fourth-anniversary-producer-letter/",
           "target": "BLANK",
           "rel": {
            "noreferrer": true
           }
          }
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "textData": {
       "text": " by July 2025. It added Mega Evolutions that same year. In July 2026 it left the World Championships to get ",
       "decorations": []
      }
     },
     {
      "type": "TEXT",
      "textData": {
       "text": "its own tournament",
       "decorations": [
        {
         "type": "LINK",
         "linkData": {
          "link": {
           "url": "https://unite.pokemon.com/en-us/news/unite-championship-series-update/",
           "target": "BLANK",
           "rel": {
            "noreferrer": true
           }
          }
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "textData": {
       "text": ", and ",
       "decorations": []
      }
     },
     {
      "type": "TEXT",
      "textData": {
       "text": "Inven Global",
       "decorations": [
        {
         "type": "LINK",
         "linkData": {
          "link": {
           "url": "https://www.invenglobal.com/articles/27753/once-an-official-asian-games-medal-event-pok%C3%A9mon-unite-to-end-service-in-march-2027",
           "target": "BLANK",
           "rel": {
            "noreferrer": true
           }
          }
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "textData": {
       "text": " points out it was once an official Asian Games medal event. Three months later, the plan is to switch it off.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
