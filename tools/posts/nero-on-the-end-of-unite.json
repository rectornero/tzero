    }
   },
   {
    "type": "PARAGRAPH",
    "nodes": [
     {
      "type": "TEXT",
      "textData": {
       "text": "Three practical things, from the official notices and the reports above:",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "nodes": [
     {
      "type": "TEXT",
      "textData": {
       "text": "01  ",
       "decorations": [
        {
         "type": "BOLD",
         "fontWeightValue": 700
        },
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#d7182a"
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "textData": {
       "text": "Download the library before 23 March 2027.",
       "decorations": [
        {
         "type": "BOLD",
         "fontWeightValue": 700
        },
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        }
       ]
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "nodes": [
     {
      "type": "TEXT",
      "textData": {
       "text": "Without the download you can't open it after the end of service, and the data stays on that device.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "nodes": [
     {
      "type": "TEXT",
      "textData": {
       "text": "02  ",
       "decorations": [
        {
         "type": "BOLD",
         "fontWeightValue": 700
        },
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#d7182a"
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "textData": {
       "text": "Keep the app installed.",
       "decorations": [
        {
         "type": "BOLD",
         "fontWeightValue": 700
        },
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        }
       ]
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "nodes": [
     {
      "type": "TEXT",
      "textData": {
       "text": "If a refund for unused paid gems is offered in your region, it goes through a form in the game, so don't delete UNITE until that's done.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "nodes": [
