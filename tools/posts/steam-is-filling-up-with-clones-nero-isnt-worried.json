     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Valve has also added to its release checklist. Before submitting a build, developers now have to launch their game through the Steam client and keep it running for at least five minutes. Reviews of new games can take up to 12 business days (",
       "decorations": []
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "HotHardware",
