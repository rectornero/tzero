        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#d7182a"
         }
        },
        {
         "type": "LINK",
         "linkData": {
          "link": {
           "url": "https://www.gamesradar.com/games/valve-acknowledges-steams-ai-problem-as-next-fest-exposes-thousands-of-low-quality-games-but-says-it-doesnt-want-to-tell-devs-which-tools-they-should-or-shouldnt-use/",
           "target": "BLANK"
          }
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "). Some indie developers even said they'd been threatened: pay, or an AI clone of your game comes out first.",
       "decorations": []
      }
