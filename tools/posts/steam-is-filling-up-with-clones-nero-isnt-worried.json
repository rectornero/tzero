    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Nero answered “not really”, and then explained why, in a way only he could:",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "BLOCKQUOTE",
    "id": "",
    "nodes": [
     {
      "type": "PARAGRAPH",
      "id": "",
      "nodes": [
       {
        "type": "TEXT",
        "id": "",
        "nodes": [],
        "textData": {
         "text": "People have been cloning games since forever! We're a studio that is born with research and discovery in mind: there's no way one copy the flame in people's hearts. And, if they really manage to, then it means we have more friends! When it comes to games specifically, I guess they'll help extending our reach, and I'll file it under advertisement unforeseen expenses!",
         "decorations": [
          {
           "type": "ITALIC",
           "italicData": true
          },
