        "id": "",
        "nodes": [],
        "textData": {
         "text": "— Nero",
         "decorations": [
          {
           "type": "BOLD",
           "fontWeightValue": 700
          },
          {
           "type": "COLOR",
           "colorData": {
            "foreground": "#d7182a"
           }
          },
          {
           "type": "FONT_SIZE",
           "fontSizeData": {
            "unit": "PX",
            "value": 13
