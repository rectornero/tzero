      "nodes": [],
      "textData": {
       "text": "One more twist. The heroes of Nero's Contrary Quest games are diligent geniuses who are secretly lazy, in a genius way. So I asked him whether he worries about his own games coming out sloppy:",
       "decorations": []
      }
     }
    ],
