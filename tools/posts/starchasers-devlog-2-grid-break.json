     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "v0.4 to v0.5: one build line, and hundreds",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        }
       ]
      }
     }
    ],
    "headingData": {
     "level": 2
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Until then, menus, story and battle had been built side by side as separate tests. On 4 November Nero asked for the game to be coherent, so everything joined one build line, and from v0.4.1 every build has the menus, the story and the battles together, with the same look and icons on every screen.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Nero's battle notes from that playtest were clear: damage numbers in the hundreds, clumping the whole team together must stop being the best move, and ultimates with cut-ins. v0.5 did all three.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
