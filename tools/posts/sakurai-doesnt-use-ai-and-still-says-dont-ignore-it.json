      "id": "",
      "nodes": [
       {
        "type": "TEXT",
        "id": "",
        "nodes": [],
        "textData": {
         "text": "— Nero",
         "decorations": [
          {
           "type": "BOLD",
           "fontWeightValue": 700
          },
          {
           "type": "COLOR",
           "colorData": {
            "foreground": "#d7182a"
           }
          },
          {
