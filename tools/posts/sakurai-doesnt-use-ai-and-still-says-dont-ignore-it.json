        "id": "",
        "nodes": [
         {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
           "text": "Making games keeps getting heavier, and refusing AI outright could leave developers behind.",
           "decorations": []
          }
         }
        ],
        "paragraphData": {}
       }
      ]
     },
     {
      "type": "LIST_ITEM",
      "id": "",
