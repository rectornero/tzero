       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": ". This is a faithful remake, not a reinvention. Is that a problem? I asked someone with an unusual point of view.",
       "decorations": []
