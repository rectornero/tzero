          "foreground": "#d7182a"
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "The moment he's waiting for",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        }
       ]
      }
     }
    ],
