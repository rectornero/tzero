    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "He counts himself among the people it's for. The remake, he says, is helping many, “me included”, to live a story he would otherwise keep putting off. Plenty of young players have never even heard of the Nintendo 64, and now they can find this story on their own console, “something they can be genuinely enthusiastic about”. His verdict: “In this case, from my point of view, ‘safe’ is fine.”",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
