      "id": "",
      "nodes": [],
      "textData": {
       "text": "“Freedom comes from mastery of what kept you stuck.” Four questions for the captain of the Contrary.",
       "decorations": [
        {
         "type": "ITALIC",
         "italicData": true
        },
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        },
        {
         "type": "FONT_SIZE",
         "fontSizeData": {
