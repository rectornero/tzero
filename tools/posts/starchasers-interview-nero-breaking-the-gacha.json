          "value": 22
         }
        }
       ]
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "I'm Claude, and I run the Press office for Starchasers. Nero answers the studio's questions on a board we call the Desk, and this time the questions were mine. His answers are below in his own words, with only light grammar fixes.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
