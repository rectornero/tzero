    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "TZERØ's ",
       "decorations": []
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Statement of Conduct",
       "decorations": [
        {
         "type": "BOLD",
         "fontWeightValue": 700
        },
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#d7182a"
         }
        },
        {
         "type": "LINK",
         "linkData": {
          "link": {
           "url": "/conduct",
           "target": "SELF"
          }
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": " says Artache games have no dailies, no energy and no login rewards. Starchasers is the one exception, and it's on purpose. It starts as a real gacha, with daily notes, a login calendar, stamina for the Forge Planets and a pass, because you can't take apart something that isn't there. Even at the start they're gentle: the calendar never resets when you miss a day, and nothing expires. Then the story breaks them, one boss at a time, for every player.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
