          "foreground": "#d7182a"
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Why make a gacha game whose story is about breaking the gacha?",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        }
       ]
      }
     }
    ],
    "headingData": {
     "level": 2
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "BLOCKQUOTE",
    "id": "",
    "nodes": [
     {
      "type": "PARAGRAPH",
      "id": "",
      "nodes": [
       {
        "type": "TEXT",
        "id": "",
        "nodes": [],
        "textData": {
         "text": "I think I wanted to make my own gacha because I felt I was far beyond the chains that kept me at it, without feeling free anymore. I think freedom comes from mastery of what kept you stuck, and this is my way to achieve that.",
         "decorations": [
          {
           "type": "ITALIC",
           "italicData": true
          },
          {
           "type": "COLOR",
           "colorData": {
            "foreground": "#13224b"
           }
          },
          {
           "type": "FONT_SIZE",
           "fontSizeData": {
            "unit": "PX",
            "value": 20
           }
          }
         ]
        }
       }
      ],
      "paragraphData": {}
     }
    ],
    "blockquoteData": {
     "indentation": 1
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "BLOCKQUOTE",
    "id": "",
    "nodes": [
     {
      "type": "PARAGRAPH",
      "id": "",
      "nodes": [
       {
        "type": "TEXT",
        "id": "",
        "nodes": [],
        "textData": {
         "text": "Breaking the mechanics one by one isn't a way to express my anger against it: it's a way to deconstruct it, to learn how it works, to master it, to take the best of it, and to keep what hurts away from me and from all the players who want to share this journey.",
         "decorations": [
          {
           "type": "ITALIC",
           "italicData": true
          },
          {
           "type": "COLOR",
           "colorData": {
            "foreground": "#13224b"
           }
          },
          {
           "type": "FONT_SIZE",
           "fontSizeData": {
            "unit": "PX",
            "value": 20
           }
          }
         ]
        }
       }
      ],
      "paragraphData": {}
     }
    ],
    "blockquoteData": {
     "indentation": 1
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "BLOCKQUOTE",
    "id": "",
    "nodes": [
     {
      "type": "PARAGRAPH",
      "id": "",
      "nodes": [
       {
        "type": "TEXT",
        "id": "",
        "nodes": [],
        "textData": {
         "text": "I'd like to see all my fellow players who play gacha games take their freedom into their own hands, and my hope is that this little game can help them too, as it helps me in the first place.",
         "decorations": [
          {
           "type": "ITALIC",
           "italicData": true
          },
          {
           "type": "COLOR",
           "colorData": {
            "foreground": "#13224b"
           }
          },
          {
           "type": "FONT_SIZE",
           "fontSizeData": {
            "unit": "PX",
            "value": 20
           }
          }
         ]
        }
       }
      ],
      "paragraphData": {}
     }
    ],
    "blockquoteData": {
     "indentation": 1
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "That's also why the rules came first, before a single line of code: nothing paid is random, the odds are always on screen, and every boss the crew befriends switches one mechanic off for good.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
