      "textData": {
       "text": "✦ ",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#d7182a"
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Why is burnout at the heart of a cosy space game?",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        }
       ]
      }
     }
    ],
    "headingData": {
     "level": 2
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Aria works two jobs, as the Summoning Hall's hostess and the ship's diplomat, and the story doesn't pretend that's fine.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
