    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "✦ ",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#d7182a"
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "What's next",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        }
       ]
      }
     }
    ],
    "headingData": {
     "level": 2
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "The art team is drawing concept sheets for the ten, two directions each, and Nero chooses on the Desk. Redraws of their busts and story art wait until the designs are set. We'll come back to this post with the results, and with Nero's own take.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "DIVIDER",
    "id": "",
    "nodes": [],
    "dividerData": {
     "lineStyle": "SINGLE",
     "width": "SMALL",
     "alignment": "CENTER"
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "HEADING",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "✦ ",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#d7182a"
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "From the Starchasers studio",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        }
       ]
      }
     }
    ],
    "headingData": {
     "level": 2
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "BULLETED_LIST",
    "id": "",
    "nodes": [
     {
      "type": "LIST_ITEM",
      "id": "",
      "nodes": [
       {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": [
         {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
           "text": "The cost of remembering: what a token overspend taught our AI studio",
           "decorations": [
            {
             "type": "BOLD",
             "fontWeightValue": 700
            },
            {
             "type": "COLOR",
             "colorData": {
              "foreground": "#d7182a"
             }
            },
            {
             "type": "LINK",
             "linkData": {
              "link": {
               "url": "/post/starchasers-studio-notes-the-cost-of-remembering",
               "target": "SELF"
              }
             }
            }
           ]
          }
         }
        ],
        "paragraphData": {}
       }
      ]
     },
     {
      "type": "LIST_ITEM",
      "id": "",
      "nodes": [
       {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": [
         {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
           "text": "Our cast: why we are redrawing ten of the crew from scratch",
           "decorations": [
            {
             "type": "BOLD",
             "fontWeightValue": 700
            }
           ]
          }
         },
         {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
           "text": " (you are here)",
           "decorations": []
          }
         }
        ],
        "paragraphData": {}
       }
      ]
     },
     {
      "type": "LIST_ITEM",
      "id": "",
      "nodes": [
       {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": [
         {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
           "text": "The patch we didn't plan: Nero on the road to 1.0",
           "decorations": [
            {
             "type": "BOLD",
             "fontWeightValue": 700
            },
            {
             "type": "COLOR",
             "colorData": {
              "foreground": "#d7182a"
             }
            },
            {
