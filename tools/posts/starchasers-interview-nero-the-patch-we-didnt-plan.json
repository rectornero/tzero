      "textData": {
       "text": "✦ ",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#d7182a"
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "A Characters screen for gacha players",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        }
       ]
      }
     }
    ],
    "headingData": {
     "level": 2
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "The old Characters screen tried to show everything at once. Now it's split into clear tabs (the character, their skills, their signature, their gadgets), skills level up with a new material, and you can try an ultimate in a short practice fight before you invest in it. Nero is clear it's a start:",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "BLOCKQUOTE",
    "id": "",
    "nodes": [
     {
      "type": "PARAGRAPH",
      "id": "",
      "nodes": [
       {
        "type": "TEXT",
        "id": "",
        "nodes": [],
        "textData": {
         "text": "It still needed a lot of work: gacha-related character sheets have standards that need to be met to be understood by gacha players.",
         "decorations": [
          {
           "type": "ITALIC",
           "italicData": true
          },
          {
           "type": "COLOR",
           "colorData": {
            "foreground": "#13224b"
           }
          },
          {
           "type": "FONT_SIZE",
           "fontSizeData": {
            "unit": "PX",
            "value": 20
           }
          }
         ]
        }
       }
      ],
      "paragraphData": {}
     }
    ],
    "blockquoteData": {
     "indentation": 1
    }
   },
