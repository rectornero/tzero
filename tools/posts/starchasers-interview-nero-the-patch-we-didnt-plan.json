    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Dimwick, the first town, has a new backdrop: lanterns at dusk, hiding secrets. And the new banner splashes show the crew in quiet, cosy moments aboard the ship, with the rivals heroic outdoors. That's on purpose, and it goes back to where the crew came from:",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "BLOCKQUOTE",
    "id": "",
    "nodes": [
     {
      "type": "PARAGRAPH",
      "id": "",
      "nodes": [
       {
        "type": "TEXT",
        "id": "",
        "nodes": [],
        "textData": {
         "text": "Contrary Quest is based on running away from the main quest to find secrets and comfort in the side stories. The banners reflect this fact.",
         "decorations": [
          {
           "type": "ITALIC",
           "italicData": true
          },
          {
           "type": "COLOR",
           "colorData": {
            "foreground": "#13224b"
           }
          },
          {
           "type": "FONT_SIZE",
           "fontSizeData": {
            "unit": "PX",
            "value": 20
           }
          }
         ]
        }
       }
      ],
      "paragraphData": {}
     }
    ],
    "blockquoteData": {
