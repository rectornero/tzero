    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Two systems change what it means to grow a character. ",
       "decorations": []
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Parallels",
       "decorations": [
        {
         "type": "BOLD",
         "fontWeightValue": 700
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": " replace the usual duplicate copies: each one is a letter from a version of that character whose life went differently, and what they learned changes how a move plays. Nero's reason was simple: duplicates should mean something.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
