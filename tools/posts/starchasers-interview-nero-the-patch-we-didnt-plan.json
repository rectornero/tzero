     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Ascended Forms",
       "decorations": [
        {
         "type": "BOLD",
         "fontWeightValue": 700
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": " go further. Instead of bigger numbers, a character gets a whole new form: a new look and cut-in, an upgraded skill, a new passive and a wider ultimate.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
