   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "The redesign didn't just replace the crew. It grew it. One of the early sheets was too good to throw away, and became a new crew member: ",
       "decorations": []
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Lucene",
       "decorations": [
        {
         "type": "BOLD",
         "fontWeightValue": 700
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": ", a level-headed apprentice wizard and Charlotte's closest friend. What does she bring that wasn't there before?",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "BLOCKQUOTE",
    "id": "",
    "nodes": [
     {
      "type": "PARAGRAPH",
      "id": "",
      "nodes": [
       {
        "type": "TEXT",
        "id": "",
        "nodes": [],
        "textData": {
         "text": "A same-gender relationship and a new way to explore mechanics.",
         "decorations": [
          {
           "type": "ITALIC",
           "italicData": true
          },
          {
           "type": "COLOR",
           "colorData": {
            "foreground": "#13224b"
           }
          },
          {
           "type": "FONT_SIZE",
           "fontSizeData": {
            "unit": "PX",
            "value": 20
           }
          }
         ]
        }
       }
      ],
      "paragraphData": {}
     }
    ],
    "blockquoteData": {
     "indentation": 1
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "We'll say more about Lucene in the game when the time comes. For now: she's not just a new face, she changes how one of the crew fights.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
