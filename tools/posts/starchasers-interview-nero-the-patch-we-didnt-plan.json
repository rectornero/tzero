    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "✦ ",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#d7182a"
         }
        }
       ]
      }
     },
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "A detour that became the road",
       "decorations": [
        {
         "type": "COLOR",
         "colorData": {
          "foreground": "#13224b"
         }
        }
       ]
      }
     }
    ],
    "headingData": {
     "level": 2
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "The road to 1.0 had a plan. This patch wasn't on it.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "BLOCKQUOTE",
    "id": "",
    "nodes": [
     {
      "type": "PARAGRAPH",
      "id": "",
      "nodes": [
       {
        "type": "TEXT",
        "id": "",
        "nodes": [],
        "textData": {
         "text": "This has been the greatest effort towards 1.0: our first character design push from scratch, through many rounds.",
         "decorations": [
          {
           "type": "ITALIC",
           "italicData": true
          },
          {
           "type": "COLOR",
           "colorData": {
            "foreground": "#13224b"
           }
          },
          {
           "type": "FONT_SIZE",
           "fontSizeData": {
            "unit": "PX",
            "value": 20
           }
          }
         ]
        }
       }
      ],
      "paragraphData": {}
     }
    ],
    "blockquoteData": {
     "indentation": 1
    }
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [
     {
      "type": "TEXT",
      "id": "",
      "nodes": [],
      "textData": {
       "text": "Why now, and not after 1.0? Because 1.0 should be the real cast, the one players will keep.",
       "decorations": []
      }
     }
    ],
    "paragraphData": {}
   },
   {
    "type": "PARAGRAPH",
    "id": "",
    "nodes": [],
    "paragraphData": {}
   },
   {
    "type": "BLOCKQUOTE",
    "id": "",
    "nodes": [
     {
      "type": "PARAGRAPH",
      "id": "",
      "nodes": [
       {
        "type": "TEXT",
        "id": "",
        "nodes": [],
        "textData": {
         "text": "We needed the final cast: changing it at any other time wouldn't work: it's been a forced change, but it made the game stronger.",
         "decorations": [
          {
           "type": "ITALIC",
           "italicData": true
          },
          {
           "type": "COLOR",
           "colorData": {
            "foreground": "#13224b"
           }
          },
          {
           "type": "FONT_SIZE",
           "fontSizeData": {
            "unit": "PX",
            "value": 20
           }
          }
         ]
        }
       }
      ],
      "paragraphData": {}
     }
    ],
    "blockquoteData": {
     "indentation": 1
    }
   },
