a":{}}]},{"type":"LIST_ITEM","id":"","nodes":[{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Starchasers devlog #3: landing on Weary Reach","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" (you are here)","decorations":[]}}],"paragraphData":{}}]},{"type":"LIST_ITEM","id":"","nodes":[{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Starchasers devlog #4: the whole crew comes aboard","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"LINK","linkData":{"link":{"url":"/post/starchasers-devlog-4-the-whole-crew","target":"SELF"}}}]}}],"paragraphData":{}}]},{"type":"LIST_ITEM","id":"","nodes":[{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Starchasers devlog #5: what's coming in v0.9.0","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"LINK","linkData":{"link":{"url":"/post/starchasers-devlog-5-coming-in-v0-9-0","target":"SELF"}}}]}}],"paragraphData":{}}]},{"type":"LIST_ITEM","id":"","nodes":[{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Starchasers devlog #6: v0.9.0 tested, and the road to 1.0","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"LINK","linkData":{"link":{"url":"/post/starchasers-devlog-6-road-to-1-0","target":"SELF"}}}]}}],"paragraphData":{}}]},{"type":"LIST_ITEM","id":"","nodes":[{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Breaking the gacha to be free of it: an interview with Nero","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"LINK","linkData":{"link":{"url":"/post/starchasers-interview-nero-breaking-the-gacha","ta