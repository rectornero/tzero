{"id":"eaaefdba-b5f2-4c7f-915b-30b2ff0a3e73","title":"Overwatch Hero UX: Torbjörn","excerpt":"This is a UX article: as such, it is not focused on strategy, nor background. It talks about gameplay fun and pain for the character. My second spotlight is on Torbjörn, Overwatch turret-builder. This review encompasses Torbjörn Characteristics and Abilities (which both focus on the fun of using the character) and Team Play (which focuses on how is can be fun to play with others). I used colors to classify fun level: Blue: awesome Green: fun Orange: average Gray: meh Red: painful Purple:...","firstPublishedDate":"2017-09-19T21:55:59Z","lastPublishedDate":"2017-09-19T21:55:59Z","url":{"base":"https://www.tzero.live","path":"/post/overwatch-hero-ux-torbjörn"},"slug":"overwatch-hero-ux-torbjörn","categoryIds":["6fecd53b-e26c-46ca-a508-d8b36cda3c3b"],"tagIds":[],"memberId":"38ba494c-02f6-400e-9e2d-5cb850448e7a","minutesToRead":5,"media":{"wixMedia":{"image":{"id":"38ba49_555ff19455ca4ef5854443d637cce1b7~mv2.jpg","url":"https://static.wixstatic.com/media/38ba49_555ff19455ca4ef5854443d637cce1b7~mv2.jpg","height":1080,"width":1920}},"displayed":true,"custom":true},"richContent":{"nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"This is a UX article: as such, it is not focused on strategy, nor background. It talks about gameplay fun and pain for the character.","decorations":[{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"My second spotlight is on Torbjörn, Overwatch turret-builder.","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"This review encompasses Torbjörn Characteristics and Abilities (which both focus on the fun of using the character) and Team Play (which focuses on how is can be fun to play with others)."}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"I used colors to classify fun level:"}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Blue","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":": awesome","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"\n"}},{"type":"TEXT","textData":{"text":"Green","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":": fun","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":"\n"}},{"type":"TEXT","textData":{"text":"Orange","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#ff6600"}}]}},{"type":"TEXT","textData":{"text":": average","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff6600"}}]}},{"type":"TEXT","textData":{"text":"\n"}},{"type":"TEXT","textData":{"text":"Gray","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#808080"}}]}},{"type":"TEXT","textData":{"text":": meh","decorations":[{"type":"COLOR","colorData":{"foreground":"#808080"}}]}},{"type":"TEXT","textData":{"text":"\n"}},{"type":"TEXT","textData":{"text":"Red","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#ff0000"}}]}},{"type":"TEXT","textData":{"text":": painful","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff0000"}}]}},{"type":"TEXT","textData":{"text":"\n"}},{"type":"TEXT","textData":{"text":"Purple","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#800080"}}]}},{"type":"TEXT","textData":{"text":": frustrating","decorations":[{"type":"COLOR","colorData":{"foreground":"#800080"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"DIVIDER","dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Characteristics","decorations":[{"type":"UNDERLINE","underlineData":true}]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Characteristics are Torbjörn’s downside."}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Health [200]","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff0000"}}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"200 Health is bad for a defense hero. It can, though, be easily fixed with Torbjörn’s ","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff0000"}}]}},{"type":"TEXT","textData":{"text":"Armor Pack","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff0000"}},{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":" ability.","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff0000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Armor [0]","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#ff6600"}}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"No armor for this hero. This is fixed by his own ","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff6600"}}]}},{"type":"TEXT","textData":{"text":"Armor Pack","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff6600"}},{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":" ability.","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff6600"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Shield [0]","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#ff6600"}}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"As expected for a defense hero.","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff6600"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Mobility [average, grounded]","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#808080"}}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Torbjörn’s mobility is average, but ","decorations":[{"type":"COLOR","colorData":{"foreground":"#808080"}}]}},{"type":"TEXT","textData":{"text":"he can’t leave ground without support. This is not good, as this limits the places in which you can place your turret.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#808080"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Hit-Box [large]","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#ff0000"}}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Torbjörn is short, but large. This makes him an easy target, especially for Pharah, who can easily shoot him AND his turret if they are together.","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff0000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Abilities","decorations":[{"type":"UNDERLINE","underlineData":true}]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Incredibly nice abilities. There are no boring ones."}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Rivet Gun","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}},{"type":"ITALIC","italicData":true}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"I love this weapon. It can work wonders.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Projectile mode is the one that you’ll be using most as a sort-of second turret. Its projectiles have constant effectiveness, regardless of the distance. They design an arc, so they can overcome barriers and walls and used as a spacing tool. 70 damage per hit is good, even if the rounds are a bit slow. As it is a long-range shot, though, it works wonderfully. Also, it can head-shot if you’re lucky, netting 140 damage. When accompanied by the turret, this can be devastating. ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"This weapon mode is very, very easy and fun to use, but you need some backup","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":" (front-line team-mates or turret firing) or cover, as any enemy that is aiming for you can dodge your shots and reach you. Also, aestethically the shots are fire bullets. They are nice to see (especially when they hit!).","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Shotgun mode is also quite good: it can headshot, netting up to 300 damage. Useful to get rid of DPS enemies at close-range. You still benefit from some back-up. You can always set up a level-1 turret which distracts your opponents and/or takes away some health from them. In a duel you are a large target, this won’t benefit. Remember to ALWAYS set-up Armor Pack on yourself when you are forced (or willing) to duel. Also, you can benefit from throwing packs under your feet: when the first is depleted, another is immediately activated. With this in mind, ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"you can find nice time getting rid of one or even a couple of DPSs who were (maybe) already weakened by your turret","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":". Brief note: your bullets are magma shards: fantastic!","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Build Turret","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}},{"type":"ITALIC","italicData":true}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Who doesn’t love turrets?","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"He can’t build more than one turret but can upgrade the one he can built with ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"Forge Hammer","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}},{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":".","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"On defense maps, you usually build the turret before the start. Looking for the perfect place and the act of building the turret will keep you busy, and ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"make waiting time worth","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":".","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"During the fight, your turret laser-points your enemies. You can follow the pointer and fire alongside it (possibly from another location, especially is Pharah is in the skies), taking down careless enemies that comes for you without caring about the turret, or vice-versa. ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"The bond with your turret, the laser which seems to aim for you and your Rivet Gun getting the kill with fire bullets / shards… cool hot.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"You can (and should) drop level-1 turrets when you’re in danger: this can often buy you time and make you escape. ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"Escaping while your turret covers your back is cool","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":".","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Forge Hammer","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}},{"type":"ITALIC","italicData":true}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Working on a turret feels rewarding","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":", regardless from effectiveness: it’s always nice to see your turret be upgraded as a tough level-2 turret before or between the fights.","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Forge Hammer also can heal your turret (50 health per hit). You’re going to use this mainly between fights (which means, when the opposing team is weakened). ","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":"Keeping your turret alive while it kills your enemy is fine","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":", as long as your watch your back for DPSs, mostly Pharah: ","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":"being hit by Pharah together with your turret is a pain","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":".","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"It can also be used as a melee weapon, but your Rivet Gun usually does the job better. ","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":"It’s fun to KO an opponent with an hammer hit, but it is usually difficult","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":".","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Armor Pack","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}},{"type":"ITALIC","italicData":true}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Armor Pack is your main supporting option. Through this ability, at the cost of 50 scrap (see ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"Scrap Collector","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}},{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":") you drop a module that gives a (non-regenerating) +75 armor boost to your friend’s health. You hear “I need armor” instead of “I need healing” from your comrades, and, yes, ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"you also feel as the backup healer. People are usually grateful for your boost, and this feels rewarding by itself. This is a overly-nice ability, and nets you some great fun and love.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"+75 armor is also your first priority for yourself: your 200 Health is poor, and this ability fixes it, bringing your health to the likes of (actually: a bit better than) Reaper. ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"Having self-sustainability is always welcome","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":".","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Scrap Collector","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}},{"type":"ITALIC","italicData":true}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Your scrap gauge is used to drop Armor Packs. It feels at a rate of 2 scraps per second. Also, when an enemy, an ally die or your turret is destroyed, a scrap module is left.","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"When there are not too many bullets around or a Pharah above, you can go gathering scrap modules, which, again, ","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":"gives you something to do when the situation is calm / boring","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":", and also is a reward to go scouting (which could be useful in organised team play).","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"As they could just leave the scrap collection as an automatic increase, this is a nice add. Torbjörn never sleeps!","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Ultimate: ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"Molten Core","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}},{"type":"ITALIC","italicData":true}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"12 seconds of AWESOMENESS","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":". Reasons:","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"First: you get 300 armor. This brings your health up to 575, and ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"makes you (unofficially) a D.VA ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"(","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"D.VO","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}},{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":"?) for the duration of the ability.","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Second: you get +50% rate of fire, ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"making you a Reaper++","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":". Run into enemies and fire your shotgun. Easy & straightforward.","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Third: if you have a deployed level-2 turret, it is upgraded to level-3. It gets +500 Health, a ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"ROCKET LAUNCHER","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":" and one more hit-scan shooting round per second: this more than doubles its damage output per second.","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Ah, and now ","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":"you and your turret are HOT (literally and aesthetically)","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":".","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Team Play","decorations":[{"type":"UNDERLINE","underlineData":true}]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Usually pleasant team play. Synergises with Symmetra."}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"ORDERED_LIST","nodes":[{"type":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"It’s","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":" common to receive “thanks”","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}},{"type":"TEXT","textData":{"text":" as you can work the role of a second healer. Also, the turret can save someone’s back.","decorations":[{"type":"COLOR","colorData":{"foreground":"#0000ff"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Can be troublesome while attacking","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#ff0000"}}]}},{"type":"TEXT","textData":{"text":", as it is a big target and its tools are not so “agile”.","decorations":[{"type":"COLOR","colorData":{"foreground":"#ff0000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"As Torbjörn I usually feel welcome by the team","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":". This is nice.","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Sweet in helping keeping chokepoints","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":" while defending.","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Can help Symmetra","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":", and her ","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":"Shield Generator","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}},{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":" can help every character keeping their extra armor safe for when they really need it (not soft / random fire).","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]}],"orderedListData":{"indentation":0}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Overall teamwork evaluation: ","decorations":[{"type":"COLOR","colorData":{"foreground":"#008000"}}]}},{"type":"TEXT","textData":{"text":"good","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","col