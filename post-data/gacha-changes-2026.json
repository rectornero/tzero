llData":{}},{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"First Hoyoverse correction"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}}]},{"type":"TABLE_ROW","nodes":[{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Wuthering Waves"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"80 pity","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":", 50/50 + guarantee"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"100% guaranteed","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Optimization-focused"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}}]},{"type":"TABLE_ROW","nodes":[{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Stella Sora"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Fixed 120 pity","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Partly free"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"High accessibility"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}}]},{"type":"TABLE_ROW","nodes":[{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Arknights: Endfield"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"80 pity","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":", 50/50 with reruns on loss"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"120 hard pity (no carry-over)","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Integrated model","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"tableCellData":{}}]}],"tableData":{"dimensions":{"colsWidthRatio":[185,185,185,185],"rowsHeight":[0,0,0,0,0,0,0],"colsMinWidth":[120,120,120,120]}}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Looking at the table, Endfield stands out not for generosity, but for "}},{"type":"TEXT","textData":{"text":"how it redistributes risk","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":"."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"What Endfield Actually Does"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"IMAGE","nodes":[{"type":"CAPTION","nodes":[{"type":"TEXT","textData":{"text":"Double pity like in Stella Sora, and… an accessory weapon banner tied to the character banner?"}}],"captionData":{"textStyle":{"textAlignment":"AUTO"}}}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"38ba49_4ca0a3ad67ff441e9905348b8e18e9a5~mv2.jpg"},"width":2560,"height":1407},"caption":"Double pity like in Stella Sora, and… an accessory weapon banner tied to the character banner?"}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Endfield uses a "}},{"type":"TEXT","textData":{"text":"non-binary 50/50","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":" system. Missing the featured character does not automatically result in a low-value outcome: the system can still return "}},{"type":"TEXT","textData":{"text":"recent limited operators from previous banners","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":", rather than only standard-pool characters."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"IMAGE","nodes":[{"type":"CAPTION","nodes":[{"type":"TEXT","textData":{"text":"I really didn’t expect this feature at all, but it increases the chances of being satisfied."}}],"captionData":{"textStyle":{"textAlignment":"AUTO"}}}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"38ba49_b6b9af09d7754f1ca4379bda6922843c~mv2.png"},"width":1959,"height":839},"caption":"I really didn’t expect this feature at all, but it increases the chances of being satisfied."}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"The hard guarantee arrives at "}},{"type":"TEXT","textData":{"text":"120 pulls","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":", but it is "}},{"type":"TEXT","textData":{"text":"banner-specific","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":". This makes the investment explicit and contained, rather than abstractly deferred."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"The most significant change, however, concerns equipment."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Weapons are obtained through a "}},{"type":"TEXT","textData":{"text":"resource generated by pulling on the character banner","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":". Top-tier weapon rates are relatively high, and there is "}},{"type":"TEXT","textData":{"text":"no separate premium weapon banner","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":". Optimization remains time- and resource-intensive, but it is no longer locked behind a second, independent gacha system."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Looking Back: When Wanting Was Simple"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"IMAGE","nodes":[{"type":"CAPTION","nodes":[{"type":"TEXT","textData":{"text":"The very first character banner I’ve ever seen in my life was this one."}}],"captionData":{"textStyle":{"textAlignment":"AUTO"}}}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"38ba49_7d5edfdfe46d44b3b5a09dfab31ce642~mv2.png"},"width":766,"height":401},"caption":"The very first character banner I’ve ever seen in my life was this one."}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Early "}},{"type":"TEXT","textData":{"text":"Genshin Impact","decorations":[{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":" framed desire around "}},{"type":"TEXT","textData":{"text":"identity and gameplay change","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":", not efficiency. A 90-pull banner with a 50% chance felt like an opportunity rather than an obligation."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Only later did soft pity and real probability curves become widely understood, and the "}},{"type":"TEXT","textData":{"text":"0.6% base rate","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":" began to feel oppressive—especially once standard characters lost relevance."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"From Characters to Equipment"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"IMAGE","nodes":[{"type":"CAPTION","nodes":[{"type":"TEXT","textData":{"text":"One of the most infamous banners in gacha history… for reasons that were anything but pleasant."}}],"captionData":{"textStyle":{"textAlignment":"AUTO"}}}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"38ba49_7b63a69d50d843d3ae4fea4e3bcf1355~mv2.jpg"},"width":640,"height":315},"caption":"One of the most infamous banners in gacha history… for reasons that were anything but pleasant."}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Over time, desire shifted from characters to "}},{"type":"TEXT","textData":{"text":"numerical optimization","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":"."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Weapon banners like Staff of Homa marked a turning point: the focus moved away from playstyle and toward efficiency. Even after later adjustments by Hoyoverse, equipment remained the true bottleneck."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"The Thirst for Completion"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"IMAGE","nodes":[{"type":"CAPTION","nodes":[{"type":"TEXT","textData":{"text":"Because of the incredible power of the talent unlocked by The Herta’s second Eidolon, I made the reckless decision to go for seven copies…"}}],"captionData":{"textStyle":{"textAlignment":"AUTO"}}}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"38ba49_08f09b97eb21413dab17429b1aadc8f6~mv2.png"},"width":2560,"height":1440},"caption":"Because of the incredible power of the talent unlocked by The Herta’s second Eidolon, I made the reckless decision to go for seven copies…"}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Honkai: Star Rail","decorations":[{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":" amplified this dynamic through "}},{"type":"TEXT","textData":{"text":"Light Cones, Eidolons, and copy-based power scaling","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":"."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"At that point, chasing duplicates stopped being about discovery and became about "}},{"type":"TEXT","textData":{"text":"completing a system","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":". That was the breaking point."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Early Corrections"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"IMAGE","nodes":[{"type":"CAPTION","nodes":[{"type":"TEXT","textData":{"text":"Seemingly generous… but is it really?"}}],"captionData":{"textStyle":{"textAlignment":"AUTO"}}}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"38ba49_67c65885259b47bb86554438659eb474~mv2.png"},"width":1200,"height":675},"caption":"Seemingly generous… but is it really?"}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Some titles attempted partial fixes:"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"BULLETED_LIST","nodes":[{"type":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Wuthering Waves","decorations":[{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":" reduced frustration by guaranteeing weapons, but still tied optimization to premium resources."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}]},{"type":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Stella Sora","decorations":[{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":" raised base rates, but without enough gameplay pressure to make pulls feel meaningful."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}]},{"type":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Duet Night Abyss","decorations":[{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":" removed character gacha entirely, replacing it with acquisition systems that feel structurally weaker."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}]}],"bulletedListData":{"indentation":0}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"A Signal from Hoyoverse"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"IMAGE","nodes":[{"type":"CAPTION","nodes":[{"type":"TEXT","textData":{"text":"One of the loudest pieces of news from version 2.5: the first ever 100% guarantee in Hoyoverse."}}],"captionData":{"textStyle":{"textAlignment":"AUTO"}}}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"38ba49_18881d3c953b42f69cf8a110c23562ae~mv2.png"},"width":1920,"height":1080},"caption":"One of the loudest pieces of news from version 2.5: the first ever 100% guarantee in Hoyoverse."}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"With version 2.5, "}},{"type":"TEXT","textData":{"text":"Zenless Zone Zero","decorations":[{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","textData":{"text":" introduced "}},{"type":"TEXT","textData":{"text":"100% guaranteed reruns","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":" within a capped pull range."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"This does not change the core model, but it acknowledges a difference between "}},{"type":"TEXT","textData":{"text":"new acquisition","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":" and "}},{"type":"TEXT","textData":{"text":"roster maintenance","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":". It is not a revolution, but it is a clear adjustment."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Why Endfield Is Different"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"IMAGE","nodes":[{"type":"CAPTION","nodes":[{"type":"TEXT","textData":{"text":"The weapon banner, with the ability to even "}},{"type":"TEXT","textData":{"text":"purchase","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":" specific weapons with points, besides pulling."}}],"captionData":{"textStyle":{"textAlignment":"AUTO"}}}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"38ba49_cd32aebcfd694055a2dc5e130969dcb8~mv2.png"},"width":1200,"height":675},"caption":"The weapon banner, with the ability to even purchase specific weapons with points, besides pulling."}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Endfield does not remove risk. It "}},{"type":"TEXT","textData":{"text":"changes where risk matters","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":"."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Characters remain costly decisions, but power is no longer locked behind a second toll. Failure still produces usable outcomes, and optimization emerges as a consequence of play rather than a parallel system."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Conclusion"}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"The core issue with gacha has never been randomness itself, but "}},{"type":"TEXT","textData":{"text":"how risk has been layered and compounded","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":" over time."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"Endfield represents an attempt—still imperfect, but deliberate—to unwind that accumulation."}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"AUTO","lineHeight":"1.5"}}}],"documentStyle":{}}}