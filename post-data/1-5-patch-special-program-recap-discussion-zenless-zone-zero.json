":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"10 more encrypted tapes","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":" (!!)"}}],"paragraphData":{}}]},{"type":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"480 polychromes (equaling "}},{"type":"TEXT","textData":{"text":"3 encypted tapes","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","textData":{"text":")"}}],"paragraphData":{}}]},{"type":"LIST_ITEM","nodes":[{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"10 Boopons"}}],"paragraphData":{}}]}],"bulletedListData":{"indentation":0}},{"type":"PARAGRAPH","paragraphData":{}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"23 encrypted tapes from login only is very good, even for Star Rail standards! Considering how little we get from shop packs, in Hoyoverse games, this is great news for who is going for as many character as possible, or W-Englines/Mindscapes."}}],"paragraphData":{}},{"type":"PARAGRAPH","paragraphData":{}},{"type":"HEADING","nodes":[{"type":"TEXT","textData":{"text":"Other minor things"}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"}}},{"type":"IMAGE","nodes":[{"type":"CAPTION","nodes":[{"type":"TEXT","textData":{"text":"Very cute little boy!"}}]}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"38ba49_0023054583c24851bc0454aa66774541~mv2.png"},"width":984,"height":413},"caption":"Very cute little boy!"}},{"type":"PARAGRAPH","nodes":[{"type":"TEXT","textData":{"text":"New partner archives (dating sim) for the new characters, one signature W-Engine each, a new Bangboo, a special episode for Astra and an Agent story for Ellen."}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","nodes":[{"type":