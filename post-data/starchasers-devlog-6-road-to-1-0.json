e decisions are Nero's.","decorations":[{"type":"ITALIC","italicData":true},{"type":"COLOR","colorData":{"foreground":"#13224b"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"}}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Art: Starchasers art team, AI-generated under Nero's art direction. Screenshots from test builds; everything shown is work in progress. Made in Godot 4.","decorations":[{"type":"COLOR","colorData":{"foreground":"#6B7280"}},{"type":"FONT_SIZE","fontSizeData":{"unit":"PX","value":12}}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"}}}]}}