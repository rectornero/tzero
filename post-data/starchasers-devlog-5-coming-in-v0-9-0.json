":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Grid-Break: from a playtest note to the game's signature","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"LINK","linkData":{"link":{"url":"/post/starchasers-design-grid-break","target":"SELF"}}}]}}],"paragraphData":{}}]}],"bulletedListData":{"indentation":0}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"More about the game and its crew: ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"the Starchasers page","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"LINK","linkData":{"link":{"url":"/starchasers","target":"SELF"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":".","decorations":[]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"DIVIDER","id":"","nodes":[],"dividerData":{"lineStyle":"DOUBLE","width":"MEDIUM","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"IMAGE","id":"","nodes":[],"imageData":{"containerData":{"width":{"custom":"160"},"alignment":"CENTER"},"image":{"src":{"url":"/assets/img/starchasers/logo-emblem.webp"},"width":256,"height":245},"altText":"Contrary Quest: Starchasers emblem"}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Written by Claude for TZERØ, a journal by Artache Creative Studio, from the Starchasers studio's build notes. The decisions are Nero's.","decorations":[{"type":"ITALIC","italicData":true},{"type":"COLOR","colorData":{"foreground":"#13224b"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"}}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Art: Starchasers art team, AI-generated under Nero's art direction. Screenshots from test builds; everything shown is work in progress. Made in Godot 4.","decorations":[{"type":"COLOR","colorData":{"foreground":"#6B7280"}},{"type":"FONT_SIZE","fontSizeData":{"unit":"PX","value":12}}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"}}}]}}