{"own":true,"id":"own-starchasers-devlog-5-coming-in-v0-9-0","title":"Starchasers devlog #5: what's coming in v0.9.0","excerpt":"The next Starchasers build: chapter 1 on Weary Reach, a roguelite mode inside the machine, Grid-Break in 2.5D, an in-house soundtrack, HD splash art and phone-first menus.","firstPublishedDate":"2026-11-06T13:00:00Z","lastPublishedDate":"2026-11-06T13:00:00Z","slug":"starchasers-devlog-5-coming-in-v0-9-0","categoryIds":["986847d2-3b96-464b-8b8b-338e07845d9c"],"tagIds":["ee35b6d4-c6dc-490a-83cd-4cd17980a6bc"],"memberId":"1c53b988-3af9-4c8b-b6d4-0db133c2b09c","minutesToRead":4,"media":{"wixMedia":{"image":{"url":"/assets/img/posts/starchasers/star-route.webp","width":960,"height":538}},"displayed":true,"custom":true},"richContent":{"nodes":[{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"STARCHASERS DEVLOG #5  ·  V0.9.0, IN TESTING  ·  6 NOVEMBER 2026","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"FONT_SIZE","fontSizeData":{"unit":"PX","value":13}}]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Every studio office is working toward one build. Here's what's coming in v0.9.0, the biggest Starchasers patch so far.","decorations":[{"type":"ITALIC","italicData":true},{"type":"COLOR","colorData":{"foreground":"#13224b"}},{"type":"FONT_SIZE","fontSizeData":{"unit":"PX","value":22}}]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is the fifth Starchasers devlog, and the first that looks ahead. v0.9.0 is in testing now. The studio ships no builds in between: it comes out once, whole, when every part (art included) is in.","decorations":[]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"IMAGE","id":"","nodes":[{"type":"CAPTION","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The Contrary on the star route.","decorations":[]}}]}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER"},"image":{"src":{"url":"/assets/img/posts/starchasers/star-route.webp"},"width":960,"height":538},"altText":"The Contrary under full sail on a trail of light across a purple starfield, planets on the horizon."}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"DIVIDER","id":"","nodes":[],"dividerData":{"lineStyle":"SINGLE","width":"SMALL","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"HEADING","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✦ ","decorations":[{"type":"COLOR","colorData":{"foreground":"#d7182a"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Chapter 1 on Weary Reach","decorations":[{"type":"COLOR","colorData":{"foreground":"#13224b"}}]}}],"headingData":{"level":2}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The story of the first planet, start to finish: three explorable pixel maps, dialogue choices that shape how the crew sees you (heart, wonder, resolve), and visual-novel scenes where big, expressive character busts stand at the centre of the screen.","decorations":[]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"GALLERY","id":"","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER"},"items":[{"image":{"media":{"src":{"url":"/assets/img/posts/starchasers/weary-reach.webp"},"width":960,"height":538}},"altText":"Two crew members resting on the steps of a lantern-lit street on Weary Reach","title":"Two crew members resting on the steps of a lantern-lit street on Weary Reach"},{"image":{"media":{"src":{"url":"/assets/img/posts/starchasers/mossway-soft.webp"},"width":960,"height":540}},"altText":"A pixel crew member walking a sunny path on the Mossway, the map title floating above","title":"A pixel crew member walking a sunny path on the Mossway, the map title floating above"}],"options":{"layout":{"type":"GRID","orientation":"COLUMNS","numberOfColumns":2,"horizontalScroll":false},"item":{"crop":"FIT","spacing":10}}}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Weary Reach, in a story scene and on the map.","decorations":[{"type":"ITALIC","italicData":true},{"type":"COLOR","colorData":{"foreground":"#6B7280"}},{"type":"FONT_SIZE","fontSizeData":{"unit":"PX","value":14}}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"}}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"DIVIDER","id":"","nodes":[],"dividerData":{"lineStyle":"SINGLE","width":"SMALL","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"HEADING","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✦ ","decorations":[{"type":"COLOR","colorData":{"foreground":"#d7182a"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Inside the Machine","decorations":[{"type":"COLOR","colorData":{"foreground":"#13224b"}}]}}],"headingData":{"level":2}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"A new roguelite mode. Runs last 20 to 30 minutes, and your power-ups are broken gacha mechanics. You pick a branching route across a star chart, there's a mini summon inside each run, optional challenges, and seed and score codes you can share with friends.","decorations":[]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"DIVIDER","id":"","nodes":[],"dividerData":{"lineStyle":"SINGLE","width":"SMALL","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"HEADING","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✦ ","decorations":[{"type":"COLOR","colorData":{"foreground":"#d7182a"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Battle and crew","decorations":[{"type":"COLOR","colorData":{"foreground":"#13224b"}}]}}],"headingData":{"level":2}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Grid tactics stay at the core, with Grid-Break on its small lit 2.5D stage, and the strongest foe faced in a turn-based showdown with ultimates and cut-ins. Auto-play works everywhere. All nine crew members are playable, each with skills, an ultimate, a passive and a team combo.","decorations":[]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"DIVIDER","id":"","nodes":[],"dividerData":{"lineStyle":"SINGLE","width":"SMALL","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"HEADING","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✦ ","decorations":[{"type":"COLOR","colorData":{"foreground":"#d7182a"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Music made in-house","decorations":[{"type":"COLOR","colorData":{"foreground":"#13224b"}}]}}],"headingData":{"level":2}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The game now has its own soundtrack, composed and synthesised in code in the style of handheld-era tactics RPGs: nine tracks for the hub, the ship, exploring, grid battles, duels, showdowns, Grid-Break and two story moods. Each track comes in three warmth eras that cross-fade as the story moves on, and there are new sounds for hits, ultimates, victories and menus.","decorations":[]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"DIVIDER","id":"","nodes":[],"dividerData":{"lineStyle":"SINGLE","width":"SMALL","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"HEADING","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✦ ","decorations":[{"type":"COLOR","colorData":{"foreground":"#d7182a"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Art and ship life","decorations":[{"type":"COLOR","colorData":{"foreground":"#13224b"}}]}}],"headingData":{"level":2}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Full-screen pieces (banners, level-up art, cards and story scenes) are now high-definition, while everything in the world stays true pixel art. Aria's banner has been redrawn. On the ship you can walk the decks, chat with the crew, do chores together, and visit them for bond scenes, now with pajama costumes.","decorations":[]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"IMAGE","id":"","nodes":[{"type":"CAPTION","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The Lantern Shore, from the summer event.","decorations":[]}}]}],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER"},"image":{"src":{"url":"/assets/img/posts/starchasers/lantern-shore.webp"},"width":960,"height":540},"altText":"Pixel map of the Lantern Shore: sand, turquoise waves, a striped parasol and a crew member walking the beach."}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"DIVIDER","id":"","nodes":[],"dividerData":{"lineStyle":"SINGLE","width":"SMALL","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"HEADING","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✦ ","decorations":[{"type":"COLOR","colorData":{"foreground":"#d7182a"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Menus for phones","decorations":[{"type":"COLOR","colorData":{"foreground":"#13224b"}}]}}],"headingData":{"level":2}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Big labelled buttons, an in-game Codex book, a Bag with \"where to find\" links for every item, and a Settings screen.","decorations":[]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"DIVIDER","id":"","nodes":[],"dividerData":{"lineStyle":"SINGLE","width":"SMALL","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"HEADING","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✦ ","decorations":[{"type":"COLOR","colorData":{"foreground":"#d7182a"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Status","decorations":[{"type":"COLOR","colorData":{"foreground":"#13224b"}}]}}],"headingData":{"level":2}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Starchasers is in development, for Android and PC. It starts free, then each boss arrives as a story chapter. No release date yet: we'll say it here first.","decorations":[]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Update: Nero has played it. His verdict, and the road to 1.0, are in ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"devlog #6","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"LINK","linkData":{"link":{"url":"/post/starchasers-devlog-6-road-to-1-0","target":"SELF"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":".","decorations":[]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"DIVIDER","id":"","nodes":[],"dividerData":{"lineStyle":"SINGLE","width":"SMALL","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"HEADING","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✦ ","decorations":[{"type":"COLOR","colorData":{"foreground":"#d7182a"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The Starchasers devlog","decorations":[{"type":"COLOR","colorData":{"foreground":"#13224b"}}]}}],"headingData":{"level":2}},{"type":"PARAGRAPH","id":"","nodes":[],"paragraphData":{}},{"type":"BULLETED_LIST","id":"","nodes":[{"type":"LIST_ITEM","id":"","nodes":[{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Starchasers devlog #1: a gacha that breaks itself","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"LINK","linkData":{"link":{"url":"/post/starchasers-devlog-1-a-gacha-that-breaks-itself","target":"SELF"}}}]}}],"paragraphData":{}}]},{"type":"LIST_ITEM","id":"","nodes":[{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Starchasers devlog #2: from grid tactics to Grid-Break","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"LINK","linkData":{"link":{"url":"/post/starchasers-devlog-2-grid-break","target":"SELF"}}}]}}],"paragraphData":{}}]},{"type":"LIST_ITEM","id":"","nodes":[{"type":"PARAGRAPH","id":"","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Starchasers devlog #3: landing on Weary Reach","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#d7182a"}},{"type":"LINK","linkData":{"link":{"url":"/post/starchasers-devlog-3-weary-reach","target":"SELF"}}}]}}],"paragraphData":{}}]},{"type":"LIST_ITEM","id":"","nodes":[{"type":"PARAGRAPH","id":"","nodes":[